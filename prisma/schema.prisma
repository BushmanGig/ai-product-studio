// AI Product Studio schema.
//
// Local development uses SQLite for zero-config setup. To migrate to
// Supabase/Postgres later, change `provider` to "postgresql" and point
// DATABASE_URL at your Postgres connection string (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  summary     String
  status      String   @default("Active")
  stage       String   @default("Idea")
  priority    String   @default("Medium")
  progress    Int      @default(0)
  nextAction  String   @default("")
  color       String   @default("#6366f1")
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities  Activity[]
  buildTasks  BuildTask[]
  qaItems     QaItem[]
  launchItems LaunchItem[]
  reviews     Review[]
  blueprint   Blueprint?
  prompts     Prompt[]
}

model Activity {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type      String   @default("update")
  message   String
  createdAt DateTime @default(now())
}

model Blueprint {
  id                String   @id @default(cuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vision            String   @default("")
  targetUsers       String   @default("")
  problemStatement  String   @default("")
  successMetrics    String   @default("")
  userStories       String   @default("")
  featureScope      String   @default("")
  risksAssumptions  String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BuildTask {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    String   @default("Backlog")
  priority  String   @default("Medium")
  estimate  String   @default("")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QaItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  String   @default("General")
  label     String
  checked   Boolean  @default(false)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LaunchItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel   String
  title     String
  status    String   @default("Planned")
  dueLabel  String   @default("")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  kind      String   @default("Design")
  status    String   @default("Awaiting review")
  reviewer  String   @default("")
  createdAt DateTime @default(now())
}

model Prompt {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  category  String   @default("Discovery")
  body      String
  tags      String   @default("")
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
