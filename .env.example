# ---------------------------------------------------------------------------
# AI Product Studio environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development:  cp .env.example .env
# On Vercel, set these in Project Settings -> Environment Variables (never
# commit real secrets to the repo).

# --- Database (required) ---
# PostgreSQL connection string. Works with Supabase, Neon, Prisma Postgres,
# Railway, a local Postgres, or the bundled docker-compose service.
#
# Local (docker compose up -d):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_product_studio?schema=public"
#
# Supabase (use the "Connection pooling" / port 6543 string for serverless and
# append pgbouncer=true; add a DIRECT_URL for migrations if you use pooling):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Neon:
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require"

# --- AI provider (optional) ---
# "mock" (default) runs the app with no external calls and no API key required.
# "openai" enables a real OpenAI-compatible provider using the keys below.
AI_PROVIDER_MODE="mock"

# Only needed when AI_PROVIDER_MODE=openai. Never store this in the database.
# OPENAI_API_KEY="sk-..."
# Optional: override for OpenAI-compatible endpoints (Azure, OpenRouter, etc.)
# OPENAI_BASE_URL="https://api.openai.com/v1"
# Optional: model name to use.
# OPENAI_MODEL="gpt-4o-mini"
