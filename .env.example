# Local development uses SQLite.
DATABASE_URL="file:./dev.db"

# To move to Supabase/Postgres later:
# 1. Change the datasource provider in prisma/schema.prisma from "sqlite" to "postgresql".
# 2. Set DATABASE_URL to your Postgres/Supabase connection string, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# 3. Follow docs/POSTGRES.md for the full migration checklist.
# DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?schema=public"

# AI provider (server-side only — never expose these to the browser)
# Mock mode keeps generate actions working without a key.
AI_MOCK_MODE="true"
# OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE="0.4"
