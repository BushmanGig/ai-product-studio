# Local development database (PostgreSQL).
#
# This default matches the bundled docker-compose service:
#   docker compose up -d
# It is a LOCAL, non-secret credential for development only. Never commit real
# production credentials — set those in the Vercel dashboard instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_product_studio?schema=public"

# --- AI provider (optional) ---
# Controls whether AI features call a real provider. Defaults to "mock" so the
# app runs with no API keys. Set to "openai" to use a real OpenAI-compatible API.
AI_PROVIDER_MODE="mock"
# OPENAI_API_KEY="sk-..."            # optional, only when AI_PROVIDER_MODE=openai
# OPENAI_BASE_URL="https://api.openai.com/v1"  # optional, override for compatible APIs
# OPENAI_MODEL="gpt-4o-mini"          # optional, model name
